# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=bazzite-hyprland

# Make this the same as your github username/organisation
REPO_ORGANIZATION="saharariel"

IMAGE_DESC="Bazzite DX with a Hyprland desktop"
IMAGE_KEYWORDS="bootc,oci,linux,bazzite,hyprland"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"

# Upstream image this one is built on. The build pins it to an exact digest
# and records that digest in the image label below, so the scheduled check
# can tell when Bazzite has published something newer.
BASE_IMAGE="ghcr.io/ublue-os/bazzite-dx:stable"
BASE_DIGEST_LABEL="io.github.saharariel.base-digest"
